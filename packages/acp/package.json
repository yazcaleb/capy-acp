{
  "name": "capy-acp",
  "version": "0.3.0",
  "description": "Runs Capy coding-agent threads from Agent Client Protocol (ACP) clients, such as Zed, JetBrains IDEs and T3 Code. A community project, not affiliated with Capy.",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "capy",
    "coding-agent",
    "zed",
    "jetbrains",
    "t3-code"
  ],
  "homepage": "https://github.com/yazcaleb/capy-acp/tree/main/packages/acp#readme",
  "bugs": "https://github.com/yazcaleb/capy-acp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazcaleb/capy-acp.git",
    "directory": "packages/acp"
  },
  "license": "MIT",
  "author": "Yaz Caleb",
  "type": "module",
  "bin": {
    "capy-acp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs acp",
    "prepack": "node ../../scripts/build.mjs acp",
    "prepublishOnly": "pnpm --dir ../.. typecheck && pnpm --dir ../.. test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "effect": "4.1.5"
  }
}
